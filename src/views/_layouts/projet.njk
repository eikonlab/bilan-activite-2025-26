---
layout: base.njk
---

{# ============================================================
   projet.njk — Page de détail d'un projet
   Ce layout est utilisé par projets.njk (pagination Eleventy).
   La variable "projet" est l'objet du fichier JSON du projet.
   Toutes les données sont affichées, avec des {% if %} pour
   les champs optionnels — c'est ça la logique conditionnelle.
   ============================================================ #}

<div class="projet-page">
  {% if projet.thumbnail %}
    <div class="projet-page-thumbnail">
      <img src="{{ projet.thumbnail | url }}" alt="{{ projet.title }}" />
      {% if projet.tags and projet.tags.length %}
        <div class="projet-page-tags-container">
          <ul class="projet-page-tags tags">
            {% for tag in projet.tags %}
              <li>{{ tag }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <article class="projet-page-content row">
    <section class="projet-page-section-description row">
      <a
        href="{{ ('/#projet-' + projet.id) | url }}"
        class="projet-page-retour"
      >
        <button>retour</button>
      </a>

      <h1 class="projet-page-title">{{ projet.title }}</h1>

      <div class="projet-page-spacer"></div>

      <div class="projet-page-description">
        <div class="projet-page-description-content">
          {{ projet.description | markdown | safe }}
        </div>
        <p class="projet-page-description-legend">description</p>
      </div>
    </section>
    <div class="projet-page-spacer"></div>

    <section class="projet-page-section-infos row">
      {# Infos #}
      <div class="projet-page-info">
        {% if projet.clients and projet.clients.length %}
          <div class="projet-page-info-block">
            <p class="projet-page-info-title">Client.e.s</p>
            <p class="projet-page-info-content">
              {{ projet.clients | join(', ') }}
            </p>
          </div>
        {% endif %}

        <!-- <div class="projet-page-info-spacer"></div> -->

        {% if projet.mandate %}
          <div class="projet-page-info-block">
            <p class="projet-page-info-title">Type de mandat</p>
            <p class="projet-page-info-content">{{ projet.mandate }}</p>
          </div>
        {% endif %}

        {% if projet.skills %}
          <div class="projet-page-info-block">
            <p class="projet-page-info-title">Compétences</p>
            <p class="projet-page-info-content">{{ projet.skills }}</p>
          </div>
        {% endif %}

        {% if projet.sessions and projet.sessions.length %}
          <div class="projet-page-info-block">
            <p class="projet-page-info-title">Session.s</p>
            <p class="projet-page-info-content">
              {{ projet.sessions | join(', ') }}
            </p>
          </div>
        {% endif %}

        {% if projet.links and projet.links.length %}
          <div class="projet-page-info-block">
            <p class="projet-page-info-title">Liens</p>
            {% for link in projet.links %}
              <p>
                <a href="{{ link.url }}" target="_blank">{{ link.label }}</a>
              </p>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>

    <div class="projet-page-spacer"></div>

    <section class="projet-page-section-images row">
      {% if projet.images and projet.images.length %}
        {% for media in projet.images %}
          {% if media.hls or media.fichier %}
            <figure class="projet-page-images" data-pos="{{ loop.index }}">
              {% if media.hls %}
                <div
                  class="vod-player"
                  data-vod-player
                  data-hls="{{ media.hls }}"
                  tabindex="0"
                >
                  <video
                    class="vod-player__video"
                    playsinline
                    preload="metadata"
                    {% if media.poster %}poster="{{ media.poster }}"{% endif %}
                    {% if media.legend %}title="{{ media.legend }}"{% endif %}
                  ></video>
                  <button
                    type="button"
                    class="vod-player__play"
                    data-vod-play
                    aria-label="Lecture"
                  >
                    {% include "icons/play.njk" %}
                  </button>
                  <div class="vod-player__controls">
                    <button
                      type="button"
                      class="vod-player__btn"
                      data-vod-toggle
                      aria-label="Lecture"
                    >
                      <span class="vod-player__icon-play">
                        {% include "icons/play.njk" %}
                      </span>
                      <span class="vod-player__icon-pause">
                        {% include "icons/pause.njk" %}
                      </span>
                    </button>
                    <span class="vod-player__time">
                      <span data-vod-current>0:00</span>
                      <span aria-hidden="true"> / </span>
                      <span data-vod-duration>0:00</span>
                    </span>
                    <input
                      class="vod-player__seek"
                      type="range"
                      min="0"
                      max="0"
                      value="0"
                      step="0.1"
                      data-vod-seek
                      aria-label="Position"
                    />
                    <button
                      type="button"
                      class="vod-player__btn"
                      data-vod-mute
                      aria-label="Muet"
                    >
                      <span class="vod-player__icon-sound">
                        {% include "icons/volume-on.njk" %}
                      </span>
                      <span class="vod-player__icon-mute">
                        {% include "icons/volume-off.njk" %}
                      </span>
                    </button>
                    <button
                      type="button"
                      class="vod-player__btn"
                      data-vod-fs
                      aria-label="Plein écran"
                    >
                      <span class="vod-player__icon-fs-open">
                        {% include "icons/open-full-screen.njk" %}
                      </span>
                      <span class="vod-player__icon-fs-close">
                        {% include "icons/close-full-screen.njk" %}
                      </span>
                    </button>
                  </div>
                </div>
              {% else %}
                <img
                  src="{{ media.fichier | url }}"
                  alt="{{ media.legend or '' }}"
                />
              {% endif %}
              {% if media.legend %}
                <div class="projet-page-images-caption">
                  <p>{{ media.legend }}</p>
                </div>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      {% endif %}
    </section>
  </article>
</div>

{% block scripts %}
  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>
{% endblock %}
