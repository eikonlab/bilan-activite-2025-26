{
  "name": "bilan-eleventy",
  "version": "1.0.0",
  "description": "Bilan d'activité eikonlab — 2025-26",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "npm-run-all --parallel dev:eleventy dev:sass dev:js dev:cms",
    "dev:eleventy": "eleventy --serve",
    "dev:cms": "decap-server",
    "dev:sass": "sass src/assets/styles/main.scss:_site/assets/styles/main.css --watch --no-source-map",
    "dev:js": "esbuild src/assets/js/main.js --bundle --outdir=_site/assets/js --watch=forever --format=esm --splitting --chunk-names=chunks/[name]-[hash]",
    "build": "rm -rf _site && NODE_ENV=production PATH_PREFIX=/2026/ eleventy && sass src/assets/styles/main.scss _site/assets/styles/main.css --no-source-map --style=compressed && esbuild src/assets/js/main.js --bundle --outdir=_site/assets/js --format=esm --minify --splitting --chunk-names=chunks/[name]-[hash]"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "decap-cms-app": "^3.12.2",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "markdown-it": "^14.1.1",
    "papaparse": "^5.4.0",
    "sass": "^1.70.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "decap-server": "^3.7.0",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-jinja-template": "^2.2.0"
  }
}
